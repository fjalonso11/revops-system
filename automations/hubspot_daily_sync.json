      "parameters": {
        "jsCode": "const enrichments = $input.all()[0].json.enrichments;\n\nif (!enrichments || enrichments.length === 0) {\n  return [{ json: { message: '*Account Intelligence*\\nNo enrichment data available yet.' } }];\n}\n\nconst lines = ['*🔍 Account Intelligence — Top Accounts*\\n'];\n\nfor (const e of enrichments) {\n  const name = e.company_name || 'Unknown';\n  const summary = e.summary || '';\n  const signals = e.recent_signals || '';\n  \n  lines.push(`*${name}*`);\n  if (summary) lines.push(summary);\n  if (signals) lines.push(`_Recent signals:_ ${signals}`);\n  lines.push('');\n}\n\nreturn [{ json: { message: lines.join('\\n') } }];"
